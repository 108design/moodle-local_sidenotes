{{#tags}}
<form class="card mb-3 local-sidenotes-tagmanager__row" data-tagid="{{id}}" data-canmanage="{{#canmanage}}1{{/canmanage}}">
    <div class="card-body d-flex flex-wrap align-items-center" style="gap: 1rem">
        <div class="local-sidenotes-tagmanager__preview">
            <span class="badge local-sidenotes-center__tag" data-region="tag-preview" style="--sidenotes-tag-bg: {{background}}; --sidenotes-tag-fg: {{foreground}};">{{name}}</span>
            <small class="d-block text-muted mt-1">{{#str}} tags:notecount, local_sidenotes, {{notecount}} {{/str}}</small>
        </div>
        <div class="local-sidenotes-tagmanager__name">
            <label for="sidenotes-tag-name-{{id}}" class="small mb-1">{{#str}} tags:name, local_sidenotes {{/str}}</label>
            <input id="sidenotes-tag-name-{{id}}" type="text" class="form-control form-control-sm" data-region="tag-name" maxlength="100" required value="{{name}}" {{^canmanage}}readonly{{/canmanage}}>
        </div>
        <div>
            <label for="sidenotes-tag-colour-{{id}}" class="small mb-1 d-block">{{#str}} tags:colour, local_sidenotes {{/str}}</label>
            <input id="sidenotes-tag-colour-{{id}}" type="color" data-region="tag-colour" value="{{background}}" data-automatic="{{automatic}}" {{^customcolour}}disabled{{/customcolour}}>
        </div>
        <div class="form-check">
            <input id="sidenotes-tag-auto-{{id}}" class="form-check-input" type="checkbox" data-region="tag-auto" {{^customcolour}}checked{{/customcolour}}>
            <label class="form-check-label small" for="sidenotes-tag-auto-{{id}}">{{#str}} tags:automatic, local_sidenotes {{/str}}</label>
        </div>
        <div class="d-flex align-items-center ml-auto" style="gap: .5rem">
            <button type="submit" class="btn btn-primary btn-sm">{{#str}} savechanges, core {{/str}}</button>
            <button type="button" class="local-sidenotes-center__card-action" data-action="delete-tag" title="{{#str}} tags:delete, local_sidenotes {{/str}}" aria-label="{{#str}} tags:delete, local_sidenotes {{/str}}" {{^canmanage}}disabled{{/canmanage}}><i class="fa fa-trash" aria-hidden="true"></i></button>
        </div>
        {{^canmanage}}<small class="text-muted w-100">{{#str}} tags:readonly, local_sidenotes {{/str}}</small>{{/canmanage}}
    </div>
</form>
{{/tags}}
{{^tags}}<div class="alert alert-info">{{#str}} tags:empty, local_sidenotes {{/str}}</div>{{/tags}}
