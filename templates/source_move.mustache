    @template local_sidenotes/source_move
    Administrator metadata-only source move. No private note text is included.
}}
<section class="card mb-4" aria-labelledby="sidenotes-source-move-title">
    <div class="card-body">
        <h3 id="sidenotes-source-move-title" class="h5">{{status}}</h3>
        <dl>
            <dt>{{#str}}sourcemoveold, local_sidenotes{{/str}}</dt>
            <dd class="text-break">{{old}}</dd>
            <dt>{{#str}}sourcemovetarget, local_sidenotes{{/str}}</dt>
            <dd class="text-break">{{target}}</dd>
        </dl>
        <p>{{phase}}: {{progress}}</p>
        <progress value="{{percent}}" max="100" class="w-100"
            aria-label="{{progress}}">{{percent}}%</progress>
        <ul>
            <li>{{#str}}sourcemovechanged, local_sidenotes{{/str}}: {{changed}}</li>
            <li>{{#str}}sourcemovesources, local_sidenotes{{/str}}: {{sourcecount}}</li>
            <li>{{#str}}sourcemovequotes, local_sidenotes{{/str}}: {{quotecount}}</li>
            <li>{{#str}}sourcemovehashes, local_sidenotes{{/str}}: {{hashcount}}</li>
            <li>{{#str}}sourcemoveskipped, local_sidenotes{{/str}}: {{skipped}}</li>
        </ul>
        {{#ready}}<p>{{#str}}sourcemoveready, local_sidenotes{{/str}}</p>{{/ready}}
        {{#running}}<p>{{#str}}sourcemoverunning, local_sidenotes{{/str}}</p>{{/running}}
        <div class="d-flex flex-wrap" style="gap: .5rem">
            {{#actions}}
                <form method="post" action="{{url}}" {{#advance}}data-sidenotes-move-advance{{/advance}}>
                    <input type="hidden" name="action" value="{{action}}">
                    <input type="hidden" name="jobid" value="{{jobid}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn {{class}}">{{label}}</button>
                </form>
            {{/actions}}
        </div>
        <p class="mt-3 mb-0">{{#str}}sourcemovestophelp, local_sidenotes{{/str}}</p>
    </div>
</section>
